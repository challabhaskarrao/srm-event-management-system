# Web local development
VITE_API_BASE_URL=http://localhost:8080/api

# Android LAN demo: replace <LAPTOP_LAN_IP> at build time; do not commit the
# actual address. The phone and laptop must be on the same private network.
# VITE_API_BASE_URL=http://<LAPTOP_LAN_IP>:8080/api

# Production: use the deployed HTTPS API.
# VITE_API_BASE_URL=https://<production-domain>/api
