# C1 MySQL variables. Set these in your shell or an ignored local environment file.
# Never commit a real .env file or credentials.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=srm_event_management
DB_USERNAME=
DB_PASSWORD=
# Base64-encoded random signing key containing at least 32 bytes.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=srm-event-management
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOCUMENT_STORAGE_ROOT=../storage/documents
DOCUMENT_MAX_BYTES=5242880
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
PASSWORD_RESET_LIFETIME_SECONDS=1800
